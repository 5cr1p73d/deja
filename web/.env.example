# ─────────────────────────────────────────────────────────────
#  Déjà Web — variabili d'ambiente
#  Copia in `.env` e compila. NON committare `.env`.
# ─────────────────────────────────────────────────────────────

# Database (SQLite locale per dev). Per prod usa Postgres e cambia
# provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Auth.js — segreto sessione. Genera con:  npx auth secret
# (o:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="cambia-questo-segreto-con-uno-vero"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# OAuth Google — https://console.cloud.google.com/apis/credentials
# Lascia vuoto per disabilitare il pulsante Google.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OAuth Apple — https://developer.apple.com/account/resources
# AUTH_APPLE_SECRET deve essere il client secret JWT generato (ES256).
# Lascia vuoto per disabilitare il pulsante Apple.
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Admin di bootstrap (creato dal seed). Compila con i TUOI valori.
# ADMIN_PASSWORD è obbligatoria: il seed fallisce se non è impostata.
ADMIN_NICK="Scr1p73d"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Issuer mostrato nelle app TOTP (Google Authenticator, ecc.)
TOTP_ISSUER="Déjà"
