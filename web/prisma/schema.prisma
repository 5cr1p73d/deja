// Déjà Web — schema Prisma
// Dev: SQLite (file locale). Nota: SQLite non supporta enum nativi, quindi i
// campi "enum-like" sono String con valori vincolati a livello applicativo.
// Per produzione passa a "postgresql" e potrai usare enum veri.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             String    @default("USER") // USER | ADMIN
  banned           Boolean   @default(false)

  // 2FA TOTP
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret  String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  accounts         Account[]
  sessions         Session[]
  auditLogs        AuditLog[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ── Funzionalità sito ──

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  platform  String?  // windows | mac | linux
  referrer  String?
  status    String   @default("PENDING") // PENDING | INVITED | CONVERTED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  body      String
  status    String   @default("NEW") // NEW | READ | ARCHIVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String   // login | register | 2fa_enable | role_change | ...
  actorId   String?
  target    String?
  meta      String?  // JSON string
  ip        String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}
